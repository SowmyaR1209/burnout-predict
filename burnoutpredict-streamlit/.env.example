# Copy this file to .env and fill in your Supabase project credentials.
# Find them at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL= YOUR_SUPABASE_URL
SUPABASE_ANON_KEY= YOUR_SUPABASE_ANON_KEY

# Optional: only needed if you want the HR "Seed demo data" button to work
# (it bypasses RLS to create demo employees + surveys + risk scores).
SUPABASE_SERVICE_ROLE_KEY= YOUR_SUPABASE_SERVICE_ROLE_KEY
